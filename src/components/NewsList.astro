---
import { hasBody, formatDate, type NewsEntry } from '../lib/news';
interface Props { items: NewsEntry[]; showDate?: boolean }
const { items, showDate = false } = Astro.props;
---
<ul class="news-list">
  {items.map((item) => (
    <li>
      {hasBody(item)
        ? <a class="news-title" href={`/news/${item.id}`}>{item.data.title}</a>
        : <span class="news-title">{item.data.title}</span>}
      <span class="news-meta">
        {showDate && <time datetime={item.data.date.toISOString().slice(0, 10)}>{formatDate(item.data.date)}</time>}
        <span class="news-label">{item.data.label}</span>
      </span>
    </li>
  ))}
</ul>

<style>
  .news-list { list-style: none; margin: 0; padding: 0; }
  .news-list li {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .news-list li:first-child { border-top: 1px solid var(--color-border); }
  .news-title { font-weight: 600; color: var(--color-text); }
  a.news-title { text-decoration: underline; text-decoration-color: var(--color-border); text-underline-offset: 3px; }
  a.news-title:hover { color: var(--color-primary); text-decoration-color: currentColor; }
  .news-meta { display: inline-flex; gap: var(--space-3); font-size: var(--text-xs); color: var(--color-text-muted); }
</style>
