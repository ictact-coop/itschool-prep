---
// 'IT학교 한눈에 보기' 본문. 팝업(AboutDialog)과 /about 페이지가 함께 쓴다.
import { about, curriculum, school } from '../data/home';
interface Props { headingLevel?: 2 | 3 }
const { headingLevel = 2 } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';

const rows = [
  { univ: curriculum.entrance.univ, it: `${curriculum.entrance.title} — 디지털 역량진단, 16가지 활용 유형` },
  { univ: curriculum.required.univ, it: curriculum.required.subjects.map((s) => s.title).join(' · ') },
  { univ: curriculum.major.univ, it: curriculum.major.subjects.map((s) => s.title).join(' · ') },
  ...curriculum.more.map((m) => ({ univ: m.univ, it: m.title })),
];
---
<div class="about">
  {about.faq.map((item) => (
    <section class="qa">
      <H class="q">{item.q}</H>
      {item.a && <p>{item.a}</p>}
      {item.table && (
        <table>
          <caption class="visually-hidden">대학과 IT학교 비교</caption>
          <thead><tr><th scope="col">대학</th><th scope="col">IT학교</th></tr></thead>
          <tbody>
            {rows.map((r) => <tr><th scope="row">{r.univ}</th><td>{r.it}</td></tr>)}
          </tbody>
        </table>
      )}
      {item.steps && (
        <ol class="steps">
          {school.items.map((s) => <li><strong>{s.title}</strong> — {s.body}</li>)}
        </ol>
      )}
    </section>
  ))}
</div>

<style>
  .about { display: grid; gap: var(--space-5); }
  .qa { display: grid; gap: var(--space-2); }
  .q { font-size: var(--text-lg); font-weight: 800; margin: 0; }
  .qa p { color: var(--color-text); }
  table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  th, td { text-align: left; vertical-align: top; padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--color-border); }
  thead th { font-size: var(--text-xs); color: var(--color-text-muted); }
  tbody th { white-space: nowrap; color: var(--color-primary); font-weight: 700; }
  .steps { margin: 0; padding-left: 1.4em; display: grid; gap: var(--space-1); }
</style>
