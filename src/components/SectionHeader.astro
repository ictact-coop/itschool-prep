---
interface Props { id: string; title: string; lead?: string }
const { id, title, lead } = Astro.props;
---
<header class="section-header">
  <h2 id={id}>{title}</h2>
  {lead && <p>{lead}</p>}
</header>

<style>
  .section-header { display: grid; gap: var(--space-2); margin-bottom: var(--space-5); }
  h2 { font-size: var(--text-xl); font-weight: 800; }
  p { color: var(--color-text-muted); font-size: var(--text-sm); }
  @media (min-width: 48rem) { h2 { font-size: var(--text-2xl); } }
</style>
