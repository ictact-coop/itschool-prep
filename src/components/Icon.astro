---
// 장식용 아이콘. 항상 aria-hidden.
interface Props { name: string; size?: number }
const { name, size = 20 } = Astro.props;
const paths: Record<string, string> = {
  path: 'M4 19c3 0 3-6 7-6s4 6 9 6M4 5h4m8 0h4M6 5v4m12-4v4',
  tool: 'M14 7l3-3 3 3-3 3M17 7L7 17l-3 3m3-3l-3-3 3-3 3 3',
  compass: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zm3.5-12.5l-2 5-5 2 2-5 5-2z',
  share: 'M12 3v18M3 12h18M6 6l12 12M18 6L6 18',
  diamond: 'M12 3l9 9-9 9-9-9 9-9zm0 5l4 4-4 4-4-4 4-4z',
  grid: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z',
  spark: 'M12 3v5M12 16v5M3 12h5M16 12h5M6 6l3 3M15 15l3 3M18 6l-3 3M9 15l-3 3',
};
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
><path d={paths[name] ?? paths.diamond} /></svg>
