---
import Base from '../layouts/Base.astro';
---
<Base title="페이지를 찾을 수 없습니다">
  <section class="container doc">
    <h1>페이지를 찾을 수 없습니다</h1>
    <p>주소가 바뀌었거나 아직 준비 중인 페이지입니다.</p>
    <p><a href="/">첫 화면으로 돌아가기</a></p>
  </section>
</Base>

<style>
  .doc { display: grid; gap: var(--space-4); padding-block: var(--space-7); }
  h1 { font-size: var(--text-2xl); }
</style>
