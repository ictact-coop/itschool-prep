---
import { getCollection } from 'astro:content';
import NewsList from '../components/NewsList.astro';
import { getPublishedNews } from '../lib/news';
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import ApplyForm from '../components/ApplyForm.astro';
import Curriculum from '../components/Curriculum.astro';
import AboutDialog from '../components/AboutDialog.astro';
import { hero, why, school, progress, join, experiments, news } from '../data/home';

const steps = (await getCollection('steps')).sort((a, b) => a.data.order - b.data.order);
const allNews = await getPublishedNews();
const latestNews = allNews.slice(0, news.limit);

// 설명 문장 안의 핵심 낱말을 굵게 표시하기 위해 조각낸다
const leadParts = hero.lead.split(new RegExp(`(${hero.emphasis.join('|')})`)).filter(Boolean);
---
<Base>
  <!-- 02 첫 화면 -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-inner">
      <p class="hero-badge"><span class="dot" aria-hidden="true"></span>{hero.badge}</p>
      <h1 id="hero-title">
        {hero.titleLines.map((line, i) => <>{i > 0 && <br />}<span>{line}</span></>)}
      </h1>
      <p class="hero-lead">
        {leadParts.map((part) => (hero.emphasis.includes(part) ? <strong>{part}</strong> : part))}
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={hero.primary.href}>{hero.primary.label}</a>
        <a class="btn btn-outline" href={hero.about.href} data-open-about>{hero.about.label}</a>
        <a class="text-link" href={hero.secondary.href}>{hero.secondary.label} <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <!-- 03 왜 필요한가 -->
  <section class="section" aria-labelledby="why">
    <div class="container">
      <SectionHeader id="why" title={why.title} lead={why.lead} />
      <div class="worries">
        <h3 class="worries-title">{why.worriesTitle}</h3>
        <ul class="plain worry-list">
          {why.worries.map((w) => <li>“{w}”</li>)}
        </ul>
      </div>
      <ol class="grid grid-3 plain">
        {why.items.map((item, i) => (
          <li class="card">
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 04 대학처럼 배웁니다(학제 지도) -->
  <Curriculum />

  <!-- 05 배우는 방식 -->
  <section class="section" aria-labelledby="school">
    <div class="container">
      <SectionHeader id="school" title={school.title} lead={school.lead} />
      <ul class="grid grid-4 plain">
        {school.items.map((item) => (
          <li class="card">
            <span class="icon"><Icon name={item.icon} size={18} /></span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 05 설립 진행상황 -->
  <section class="section" aria-labelledby="progress">
    <div class="container">
      <SectionHeader id="progress" title={progress.title} lead={progress.lead} />
      <ol class="steps plain">
        {steps.map((step) => (
          <li class={`step step-${step.data.status}`}>
            <span class={`status status-${step.data.status}`}>{progress.statusLabel[step.data.status]}</span>
            <h3>{step.data.title}</h3>
            <p>{step.data.summary}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 06 함께하기 -->
  <section class="section" aria-labelledby="join">
    <div class="container">
      <SectionHeader id="join" title={join.title} lead={join.lead} />
      <ul class="grid grid-4 plain">
        {join.cards.map((card) => (
          <li class="card join-card">
            <p class="role">{card.role}</p>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
            <a class="card-link" href="#apply" data-preselect={card.types.join(',')}>
              이 방식으로 신청<span class="visually-hidden">: {card.title}</span> <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="form-area">
        <h3 class="form-title" id="apply">{join.formTitle}</h3>
        <ApplyForm />
      </div>
    </div>
  </section>

  <!-- 07 기존 실험 -->
  <section class="section" aria-labelledby="experiments">
    <div class="container">
      <SectionHeader id="experiments" title={experiments.title} lead={experiments.lead} />
      <ul class="grid grid-3 plain">
        {experiments.items.map((item) => (
          <li class="card exp-card">
            <span class="exp-icon"><Icon name={item.icon} size={22} /></span>
            <div>
              <h3>
                {item.href
                  ? <a class="exp-link" href={item.href} target="_blank" rel="noopener">{item.title}<span class="visually-hidden">(새 창)</span> <span aria-hidden="true">↗</span></a>
                  : item.title}
              </h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 08 준비 소식 -->
  <section class="section" aria-labelledby="news">
    <div class="container">
      <SectionHeader id="news" title={news.title} lead={news.lead} />
      <NewsList items={latestNews} />
      {allNews.length > news.limit && (
        <p class="more"><a href="/news">준비 소식 전체 보기 ({allNews.length}건)</a></p>
      )}
    </div>
  </section>

  <AboutDialog />
</Base>

<style>
  .plain { list-style: none; margin: 0; padding: 0; }

  /* 첫 화면 */
  .hero { background: linear-gradient(160deg, var(--color-hero-bg), #f3f9f6); }
  .hero-inner { display: grid; gap: var(--space-4); padding-block: var(--space-7) var(--space-8); }
  .hero-badge {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-size: var(--text-xs); font-weight: 600; color: var(--color-primary);
  }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-primary); flex: none; }
  h1 { font-size: var(--text-hero); font-weight: 800; letter-spacing: -0.02em; }
  h1 span { display: inline-block; }
  .hero-lead { max-width: 40rem; color: var(--color-text-muted); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-2); }
  .hero-lead strong { color: var(--color-text); font-weight: 700; }
  .text-link { font-size: var(--text-sm); font-weight: 600; padding: var(--space-2) var(--space-1); }

  /* 고민 */
  .worries { margin-bottom: var(--space-5); display: grid; gap: var(--space-3); }
  .worries-title { font-size: var(--text-base); font-weight: 700; }
  .worry-list { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .worry-list li {
    padding: var(--space-2) var(--space-3);
    border-radius: 999px;
    background: var(--color-hero-bg);
    font-size: var(--text-sm);
  }
  .role { font-size: var(--text-xs); font-weight: 700; color: var(--color-primary); }
  .exp-link { color: inherit; }
  .exp-link:hover { color: var(--color-primary); }

  /* 섹션 공통 */
  .section { padding-block: var(--space-7); border-top: 1px solid var(--color-border); }
  .hero + .section { border-top: 0; }
  .grid { display: grid; gap: var(--space-3); }
  .grid-3 { grid-template-columns: 1fr; }
  .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 48rem) {
    .section { padding-block: var(--space-8); }
    .grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .card {
    display: grid; align-content: start; gap: var(--space-2);
    padding: var(--space-4);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }
  @media (min-width: 48rem) { .card { padding: var(--space-5); } }
  .card h3 { font-size: var(--text-base); font-weight: 700; }
  .card p { font-size: var(--text-sm); color: var(--color-text-muted); }
  .num { font-size: var(--text-xs); font-weight: 700; color: var(--color-primary); }
  .icon { color: var(--color-primary); }

  /* 진행상황 */
  .steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5) var(--space-3); }
  @media (min-width: 48rem) { .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .step { display: grid; align-content: start; gap: var(--space-2); padding-top: var(--space-4); border-top: 3px solid var(--color-border); }
  .step-done { border-top-color: var(--color-primary); }
  .step h3 { font-size: var(--text-base); font-weight: 700; }
  .step p { font-size: var(--text-sm); color: var(--color-text-muted); }
  .status {
    justify-self: start;
    padding: 0.125rem var(--space-2);
    border-radius: 999px;
    font-size: 0.75rem; font-weight: 600;
  }
  .status-done { background: var(--status-done-bg); color: var(--status-done-text); }
  .status-doing { background: var(--status-doing-bg); color: var(--status-doing-text); }
  .status-planned { background: var(--status-plan-bg); color: var(--status-plan-text); }

  /* 함께하기 */
  .form-area { margin-top: var(--space-6); display: grid; gap: var(--space-3); }
  .form-title { font-size: var(--text-lg); font-weight: 700; }
  .join-card .card-link {
    margin-top: auto; padding-top: var(--space-2);
    font-size: var(--text-sm); font-weight: 600; text-decoration: none;
  }
  .join-card .card-link:hover { text-decoration: underline; }

  /* 기존 실험 */
  .exp-card { grid-template-columns: auto 1fr; align-items: center; gap: var(--space-4); }
  .exp-icon {
    display: grid; place-items: center;
    width: 3rem; height: 3rem;
    border-radius: var(--radius-md);
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  /* 준비 소식 */
  .more { margin-top: var(--space-4); font-size: var(--text-sm); font-weight: 600; }
</style>
