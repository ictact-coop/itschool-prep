---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublishedNews, hasBody, formatDate, type NewsEntry } from '../../lib/news';

export async function getStaticPaths() {
  const items = await getPublishedNews();
  return items.filter(hasBody).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: NewsEntry };
const { Content } = await render(entry);
---
<Base title={entry.data.title}>
  <article class="container post">
    <p class="crumb"><a href="/news">← 준비 소식</a></p>
    <header>
      <h1>{entry.data.title}</h1>
      <p class="meta">
        <time datetime={entry.data.date.toISOString().slice(0, 10)}>{formatDate(entry.data.date)}</time>{' · '}{entry.data.label}
      </p>
    </header>
    <div class="body"><Content /></div>
  </article>
</Base>

<style>
  .post { display: grid; gap: var(--space-5); max-width: 46rem; padding-block: var(--space-7) var(--space-8); }
  .crumb { font-size: var(--text-sm); }
  h1 { font-size: var(--text-2xl); }
  .meta { margin-top: var(--space-2); font-size: var(--text-sm); color: var(--color-text-muted); }
  .body { display: grid; gap: var(--space-4); }
  .body :global(h2) { font-size: var(--text-xl); margin-top: var(--space-4); }
  .body :global(h3) { font-size: var(--text-lg); margin-top: var(--space-3); }
  .body :global(ul), .body :global(ol) { margin: 0; padding-left: 1.4em; display: grid; gap: var(--space-1); }
  .body :global(img) { border-radius: var(--radius-md); }
  .body :global(blockquote) { margin: 0; padding-left: var(--space-4); border-left: 3px solid var(--color-border); color: var(--color-text-muted); }
  .body :global(table) { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; }
  .body :global(th), .body :global(td) { border: 1px solid var(--color-border); padding: var(--space-2); }
</style>
